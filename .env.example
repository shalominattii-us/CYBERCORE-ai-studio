# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OPENROUTER_API_KEY: OpenRouter API Key for Space Bunny inference proxy.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# GROK_CONNECTOR_TOKEN: Local MCP SSE gate for Aegentix_Grok_Engine (never commit the real value).
GROK_CONNECTOR_TOKEN="GROK_CONNECTOR_TOKEN"

# Stardusk Star Desk proxy. Server-side only. Never put a real token in this file or in the browser.
# HTTPS origin only: no credentials, query, fragment, or /api path.
# STARDUSK_ORIGIN=https://example.invalid
# decisions:read sdk_ token minted in the Protected Research Control Center, stored as a server secret.
# STARDUSK_DESK_TOKEN=
# Outbound research sync for scripts/stardusk_bridge.py. Not read by the browser.
# STARDUSK_MODULE_TOKEN=

# Studio session minting (POST /api/auth/session/issue) is locked unless Cloudflare Access
# sits in front of the origin and these two values are set. Placeholders only.
# CLOUDFLARE_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# CLOUDFLARE_ACCESS_AUD=
# Loopback development only. The TCP peer must be 127.0.0.1 or ::1. The Host
# header is ignored. Ignored when NODE_ENV=production. Never set this on a
# public listener or behind a reverse proxy.
# STUDIO_SESSION_ISSUE_MODE=dev-open

# ROG starlink-mcp (sovereign_tools.js) only. Placeholders. Never commit a real path
# that is C:\, a user profile, or a wallet folder. Paths stay in the service env.
# AEGENTIX_FS_ROOTS={"space-station":"C:\\path\\to\\SpaceStation","stardusk":"C:\\path\\to\\Stardusk"}
# AEGENTIX_REPO_CHECKOUTS={"space-station":"C:\\path\\to\\space-station"}
